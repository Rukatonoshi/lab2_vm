#ifndef GROUP_INFO
#define GROUP_INFO(name, arg_size, flags)
#endif

#ifndef BINOP
#define BINOP(opcode, name, symbol)
#endif

#ifndef LD
#define LD(opcode, name)
#endif

#ifndef LDA
#define LDA(opcode, name)
#endif

#ifndef ST
#define ST(opcode, name)
#endif

#ifndef PATT
#define PATT(opcode, name)
#endif

#ifndef ADDR_MODE
#define ADDR_MODE(mode, name, symbol)
#endif

#ifndef INSTR
#define INSTR(opcode, name, arg_size, flags)
#endif

// GROUP PROPERTIES
GROUP_INFO(BINOP, 0, 0)
GROUP_INFO(LD, 4, 0)
GROUP_INFO(LDA, 4, 0)
GROUP_INFO(ST, 4, 0)
GROUP_INFO(PATT, 0, 0)

// ADDRESSING MODES
ADDR_MODE(0, GLOBAL, G)
ADDR_MODE(1, LOCAL, L)
ADDR_MODE(2, ARGUMENT, A)
ADDR_MODE(3, CLOSURE, C)

// INSTRUCTION FORMAT DEFINITIONS
#ifndef INSTR_FORMAT
#define INSTR_FORMAT(name)
#endif

#ifndef FIELD_INT
#define FIELD_INT(name, size)
#endif

#ifndef FIELD_ADDR_MODE
#define FIELD_ADDR_MODE(name, mode)
#endif

#ifndef END_INSTR_FORMAT
#define END_INSTR_FORMAT(name)
#endif

// INSTRUCTION FORMATS (for variable-length instructions)
INSTR_FORMAT(CLOSURE)
    FIELD_INT("code_offset", 4)
    FIELD_INT("capture_count", 4)
    FIELD_ADDR_MODE("mode", ADDR_MODE)
    FIELD_INT("index", 4)
END_INSTR_FORMAT(CLOSURE)

// BINARY OPERATIONS
BINOP(0x01, ADD, +)
BINOP(0x02, SUB, -)
BINOP(0x03, MUL, *)
BINOP(0x04, DIV, /)
BINOP(0x05, REM, %)
BINOP(0x06, LT, <)
BINOP(0x07, LE, <=)
BINOP(0x08, GT, >)
BINOP(0x09, GE, >=)
BINOP(0x0A, EQ, ==)
BINOP(0x0B, NE, !=)
BINOP(0x0C, AND, &&)
BINOP(0x0D, OR, ||)

// LOAD INSTRUCTIONS
LD(0x20, GLOBAL)
LD(0x21, LOCAL)
LD(0x22, ARGUMENT)
LD(0x23, CLOSURE)

// LOAD ADDRESS INSTRUCTIONS
LDA(0x30, GLOBAL)
LDA(0x31, LOCAL)
LDA(0x32, ARGUMENT)
LDA(0x33, CLOSURE)

// STORE INSTRUCTIONS
ST(0x40, GLOBAL)
ST(0x41, LOCAL)
ST(0x42, ARGUMENT)
ST(0x43, CLOSURE)

// PATTERN MATCHING INSTRUCTIONS
PATT(0x60, STR)
PATT(0x61, TAG_STR)
PATT(0x62, TAG_ARR)
PATT(0x63, TAG_SEXP)
PATT(0x64, BOXED)
PATT(0x65, UNBOXED)
PATT(0x66, TAG_CLOSURE)

// STANDALONE INSTRUCTIONS
// Constants & Strings (0x10 - 0x14)
INSTR(0x10, CONST, 4, 0)
INSTR(0x11, XSTRING, 4, 0)
INSTR(0x12, SEXP, 8, 0)
INSTR(0x13, STI, 4, 0)
INSTR(0x14, STA, 4, 0)

// Jumps & Control (0x15 - 0x1B)
INSTR(0x15, JMP, 4, 0x07)     // JUMP|HALT|BREAK
INSTR(0x16, END, 0, 0x06)     // HALT|BREAK
INSTR(0x17, RET, 0, 0x06)     // HALT|BREAK
INSTR(0x18, DROP, 0, 0)
INSTR(0x19, DUP, 0, 0)
INSTR(0x1A, SWAP, 0, 0)
INSTR(0x1B, ELEM, 0, 0)

// Conditional Jumps (0x50 - 0x51)
INSTR(0x50, CJMP_ZERO, 4, 0x05)  // JUMP|BREAK
INSTR(0x51, CJMP_NOT_ZERO, 4, 0x05) // JUMP|BREAK

// Procedure & Closure (0x52 - 0x56)
INSTR(0x52, BEGIN, 8, 0)
INSTR(0x53, CBEGIN, 8, 0)
INSTR(0x54, CLOSURE, 8, 0x08)  // VARLEN flag - variable length instruction
INSTR(0x55, CALLC, 4, 0)
INSTR(0x56, CALL, 8, 0x01)    // JUMP

// Other Instructions (0x57 - 0x5A)
INSTR(0x57, TAG, 8, 0)
INSTR(0x58, ARRAY, 4, 0)
INSTR(0x59, FAIL, 8, 0x06)    // HALT|BREAK
INSTR(0x5A, LINE, 4, 0)

// Built-in Calls (0x70 - 0x74)
INSTR(0x70, CALL_READ, 0, 0)
INSTR(0x71, CALL_WRITE, 0, 0)
INSTR(0x72, CALL_LENGTH, 0, 0)
INSTR(0x73, CALL_STRING, 0, 0)
INSTR(0x74, CALL_ARRAY, 4, 0)

// NOTE: Caller is responsible for #undef-ing used macros
// #undef GROUP_INFO
// #undef BINOP
// #undef LD
// #undef LDA
// #undef ST
// #undef PATT
// #undef ADDR_MODE
// #undef INSTR
// #undef INSTR_FORMAT
// #undef FIELD_INT
// #undef FIELD_ADDR_MODE
// #undef END_INSTR_FORMAT
