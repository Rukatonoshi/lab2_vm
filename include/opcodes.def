#ifndef INSTR
#define INSTR(opcode, name, arg_size, flags)
#endif

#ifndef INSTR_GROUP
#define INSTR_GROUP(opcode, name)
#endif

#ifndef GROUP_ELEMENT
#define GROUP_ELEMENT(opcode, group, name, arg_size, flags)
#endif

#ifndef END_GROUP
#define END_GROUP
#endif

#ifndef INSTR_FLAG
#define INSTR_FLAG(name, value)
#endif

#ifndef VARLEN_INSTR
#define VARLEN_INSTR(code, name, flags, format_name, format_count)
#endif

#ifndef INSTR_FORMAT
#define INSTR_FORMAT(name)
#endif

#ifndef FORMAT_FIELD
#define FORMAT_FIELD(field_type, field_size, repeat_from)
#endif

#ifndef END_INSTR_FORMAT
#define END_INSTR_FORMAT
#endif

#ifndef ADDR_MODE
#define ADDR_MODE(name, value)
#endif

#ifndef INSTR_GROUP
#define INSTR_GROUP(opcode, name)
#endif

// INSTRUCTION FLAG DEFINITIONS
INSTR_FLAG(INSTR_FLAG_JUMP, 0x01)
INSTR_FLAG(INSTR_FLAG_HALT, 0x02)
INSTR_FLAG(INSTR_FLAG_BREAK, 0x04)
INSTR_FLAG(INSTR_FLAG_VARLEN, 0x08)
INSTR_FLAG(INSTR_FLAG_RESERVED, 0x10)

// ADDRESSING MODE DEFINITIONS
ADDR_MODE(ADDR_GLOBAL, 0x00)
ADDR_MODE(ADDR_LOCAL, 0x01)
ADDR_MODE(ADDR_ARGUMENT, 0x02)
ADDR_MODE(ADDR_CLOSURE, 0x03)

// GROUP INSTRUCTION DEFINITIONS
// Binary operations (BINOP)
INSTR_GROUP(0x00, BINOP)
    GROUP_ELEMENT(0x01, BINOP, PLUS, 0, 0)
    GROUP_ELEMENT(0x02, BINOP, MINUS, 0, 0)
    GROUP_ELEMENT(0x03, BINOP, MULTIPLY, 0, 0)
    GROUP_ELEMENT(0x04, BINOP, DIVIDE, 0, 0)
    GROUP_ELEMENT(0x05, BINOP, REMAINDER, 0, 0)
    GROUP_ELEMENT(0x06, BINOP, LESS, 0, 0)
    GROUP_ELEMENT(0x07, BINOP, LESS_EQUAL, 0, 0)
    GROUP_ELEMENT(0x08, BINOP, GREATER, 0, 0)
    GROUP_ELEMENT(0x09, BINOP, GREATER_EQUAL, 0, 0)
    GROUP_ELEMENT(0x0A, BINOP, EQUAL, 0, 0)
    GROUP_ELEMENT(0x0B, BINOP, NOT_EQUAL, 0, 0)
    GROUP_ELEMENT(0x0C, BINOP, AND, 0, 0)
    GROUP_ELEMENT(0x0D, BINOP, OR, 0, 0)
END_GROUP

// Load instructions (LD)
INSTR_GROUP(0x20, LD)
    GROUP_ELEMENT(0x20, LD, LD_GLOBAL, 4, 0)
    GROUP_ELEMENT(0x21, LD, LD_LOCAL, 4, 0)
    GROUP_ELEMENT(0x22, LD, LD_ARGUMENT, 4, 0)
    GROUP_ELEMENT(0x23, LD, LD_CLOSURE, 4, 0)
END_GROUP

// Load address instructions (LDA)
INSTR_GROUP(0x30, LDA)
    GROUP_ELEMENT(0x30, LDA, LDA_GLOBAL, 4, 0)
    GROUP_ELEMENT(0x31, LDA, LDA_LOCAL, 4, 0)
    GROUP_ELEMENT(0x32, LDA, LDA_ARGUMENT, 4, 0)
    GROUP_ELEMENT(0x33, LDA, LDA_CLOSURE, 4, 0)
END_GROUP

// Store instructions (ST)
INSTR_GROUP(0x40, ST)
    GROUP_ELEMENT(0x40, ST, ST_GLOBAL, 4, 0)
    GROUP_ELEMENT(0x41, ST, ST_LOCAL, 4, 0)
    GROUP_ELEMENT(0x42, ST, ST_ARGUMENT, 4, 0)
    GROUP_ELEMENT(0x43, ST, ST_CLOSURE, 4, 0)
END_GROUP

// Pattern match instructions (PATT)
INSTR_GROUP(0x60, PATT)
    GROUP_ELEMENT(0x60, PATT, PATT_STR, 1, 0)
    GROUP_ELEMENT(0x61, PATT, PATT_TAG_STR, 1, 0)
    GROUP_ELEMENT(0x62, PATT, PATT_TAG_ARR, 1, 0)
    GROUP_ELEMENT(0x63, PATT, PATT_TAG_SEXP, 1, 0)
    GROUP_ELEMENT(0x64, PATT, PATT_BOXED, 1, 0)
    GROUP_ELEMENT(0x65, PATT, PATT_UNBOXED, 1, 0)
    GROUP_ELEMENT(0x66, PATT, PATT_TAG_CLOSURE, 1, 0)
END_GROUP

// STANDALONE INSTRUCTION DEFINITIONS
// Constants & Strings (0x10 - 0x14)
INSTR(0x10, CONST, 4, 0)
INSTR(0x11, XSTRING, 4, 0)
INSTR(0x12, SEXP, 8, 0)
INSTR(0x13, STI, 4, 0)
INSTR(0x14, STA, 4, 0)

// Jumps & Control (0x15 - 0x1B)
INSTR(0x15, JMP, 4, 0x07)
INSTR(0x16, END, 0, 0x06)
INSTR(0x17, RET, 0, 0x06)
INSTR(0x18, DROP, 0, 0)
INSTR(0x19, DUP, 0, 0)
INSTR(0x1A, SWAP, 0, 0)
INSTR(0x1B, ELEM, 0, 0)

// Conditional Jumps (0x50 - 0x51)
INSTR(0x50, CJMP_ZERO, 4, 0x05)
INSTR(0x51, CJMP_NOT_ZERO, 4, 0x05)

// Procedure & Closure (0x52 - 0x56)
INSTR(0x52, BEGIN, 8, 0)
INSTR(0x53, CBEGIN, 8, 0)

// Variable-length instruction format
INSTR_FORMAT(closure_format)
FORMAT_FIELD(FIELD_OP, 4, -1)
FORMAT_FIELD(FIELD_COUNT, 4, 0)
FORMAT_FIELD(FIELD_OP, 5, 0)
END_INSTR_FORMAT

VARLEN_INSTR(0x54, CLOSURE, 0x08, closure_format, 3)
INSTR(0x55, CALLC, 4, 0)
INSTR(0x56, CALL, 8, 0x01)

// Other Instructions (0x57 - 0x5A)
INSTR(0x57, TAG, 8, 0)
INSTR(0x58, ARRAY, 4, 0)
INSTR(0x59, FAIL, 8, 0x06)
INSTR(0x5A, LINE, 4, 0)

// Built-in Calls (0x70 - 0x74)
INSTR(0x70, CALL_READ, 0, 0)
INSTR(0x71, CALL_WRITE, 0, 0)
INSTR(0x72, CALL_LENGTH, 0, 0)
INSTR(0x73, CALL_STRING, 0, 0)
INSTR(0x74, CALL_ARRAY, 4, 0)

// CLEANUP
#undef INSTR
#undef INSTR_GROUP
#undef GROUP_ELEMENT
#undef END_GROUP
#undef INSTR_FLAG
#undef ADDR_MODE
#undef VARLEN_INSTR
#undef INSTR_FORMAT
#undef FORMAT_FIELD
#undef END_INSTR_FORMAT
